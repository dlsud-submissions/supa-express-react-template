# ===== server/.env =====

# Docker note: injected at container start via env_file in docker-compose.yml.
# Do not commit this file. Copy from .env.example and fill in real values.

# --- Execution Environment ---
# Controls app behavior (logging, error detail)
# Options: development, test, production
NODE_ENV=development

# --- Network Configuration ---
SERVER_PORT=3000

# --- Supabase Configuration ---
# Found in Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- CORS ---
# Authorized frontend origins. Comma-separated, no spaces.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Email provider (optional) ---
# These are only needed if your application sends email via Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_ADDRESS=noreply@yourdomain.com

# --- Google OAuth ---
# Note: Most of this is configured directly in the Supabase Dashboard.
# These placeholders remind users to set up the provider.
GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET is NOT added here for security; it goes in the Supabase Dashboard.


# ===== server/.env.test =====

NODE_ENV=test
SERVER_PORT=3001
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
CORS_ALLOWED_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id
