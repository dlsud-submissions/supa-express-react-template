# ===== client/.env =====

# --- Supabase Configuration ---
# Found in Supabase Dashboard → Settings → API
# Safe to expose to the browser — RLS policies are your access guard.
# Docker note: this value is baked into the Vite bundle at build time.
# It must be present in client/.env before running docker compose up --build.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Google OAuth (Optional) ---
# Only needed if using certain client-side Google SDKs
VITE_GOOGLE_CLIENT_ID=your-google-client-id-from-console.apps.googleusercontent.com


# ===== client/.env.test =====

# --- Supabase Configuration ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_GOOGLE_CLIENT_ID=your-google-client-id-from-console.apps.googleusercontent.com
